<UserControl x:Class="Nexora.Pages.LibrariesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Nexora.Services"
    Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <Style x:Key="LibraryToggleButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="ToggleTrack" Background="Transparent" BorderBrush="#FFFFFF" BorderThickness="1" CornerRadius="13">
                                <Ellipse x:Name="ToggleThumb" Width="18" Height="18" Fill="#FFFFFF" HorizontalAlignment="Left" Margin="3,0,0,0">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="ThumbTransform" X="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleTrack" Property="Background" Value="#58AEFF"/>
                                <Setter TargetName="ToggleThumb" Property="Fill" Value="#FFFFFF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleTrack" Property="Background" Value="#173A65"/>
                                <Setter TargetName="ToggleTrack" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LibraryContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="#10233A"/>
            <Setter Property="BorderBrush" Value="#31516E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="TextElement.Foreground" Value="#F1F6FF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#10233A" BorderBrush="#31516E" BorderThickness="1" CornerRadius="6" Padding="4">
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LibraryMenuItem" TargetType="MenuItem">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuBorder" Background="Transparent" CornerRadius="6" Padding="4">
                            <ContentPresenter ContentSource="Header" Margin="6,2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuBorder" Property="Background" Value="#1B4D7A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="MenuBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="LibraryFilterItemTemplate">
            <StackPanel Orientation="Horizontal">
                <Image Source="{local:SvgImage Source=interface/white/list-tree.svg}" Width="16" Height="16" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
        <Style x:Key="LibraryFilterComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Width" Value="220"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="#0F2035"/>
            <Setter Property="BorderBrush" Value="#24415F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#F1F6FF"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinWidth" Value="220"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemTemplate" Value="{StaticResource LibraryFilterItemTemplate}"/>
            <Setter Property="ItemContainerStyle" Value="{DynamicResource LibraryFilterComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <Grid>
                                    <ContentPresenter Margin="10,0,28,0" HorizontalAlignment="Left" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center"/>
                                    <ToggleButton HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" Cursor="Hand" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><ContentPresenter/></Border></ControlTemplate></ToggleButton.Template>
                                    </ToggleButton>
                                    <Path Data="M 0 0 L 5 5 L 10 0" Stroke="#D8E7FF" StrokeThickness="1.5" Width="12" Height="8" Stretch="None" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0" IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" PopupAnimation="Fade" StaysOpen="False">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="260" Background="#0F2035" BorderBrush="#367FCE" BorderThickness="1" CornerRadius="8" Padding="2">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboBorder" Property="Background" Value="#173250"/><Setter TargetName="ComboBorder" Property="BorderBrush" Value="#367FCE"/></Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="ComboBorder" Property="Background" Value="#173250"/><Setter TargetName="ComboBorder" Property="BorderBrush" Value="#4D99F5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LibraryFilterComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="#10233A"/>
            <Setter Property="Foreground" Value="#F1F6FF"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#173250"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#173250"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LibraryCheckBox" TargetType="CheckBox">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="CheckBorder" Background="#10243A" BorderBrush="#31516E" BorderThickness="1" CornerRadius="8">
                            <TextBlock x:Name="CheckMark" Text="✓" Foreground="White" FontWeight="Bold" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#4D99F5"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="#1468D8"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="LibraryCardTemplate">
            <Border Margin="5" Padding="12" Cursor="Arrow">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Setter Property="BorderBrush" Value="#000000"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="7" VerticalAlignment="Top">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#173653"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                            <Setter Property="Background" Value="#18212B"/>
                                            <Setter Property="BorderBrush" Value="#35414D"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Image Source="{local:SvgImage Source=interface/white/package.svg}" Width="22" Height="22" Stretch="Uniform"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="6,0,8,0">
                            <TextBlock Text="{Binding Definition.Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Justify"/>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Definition.ComponentType}" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text=" · " Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Definition.ArchitectureText, StringFormat=Архитектура: {0}}" Foreground="#8FA9C6" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text=" · " Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                                <Image Width="13" Height="13" Margin="1,0,0,0" VerticalAlignment="Center">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Setter Property="Source" Value="{local:SvgImage Source=interface/other/microsoft-svgrepo-com.svg}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Definition.ComponentType}" Value="Базовый компонент"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Definition.ComponentType}" Value="Совместимость"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Definition.ComponentType}" Value="Компонент Windows"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                            <Border Background="#5A4314" BorderBrush="#D6A52B" BorderThickness="1" CornerRadius="8" Padding="8,4" Margin="0,0,6,0" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsRecommended, Converter={StaticResource BoolVisibility}}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="{local:SvgImage Source=interface/white/info-small.svg}" Width="14" Height="14" Margin="0,0,5,0"/><TextBlock Text="Рекомендуемое" Foreground="#FFE08A" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                            </Border>
                            <Border CornerRadius="9" Padding="8,4" VerticalAlignment="Top" HorizontalAlignment="Left">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#3B1D2A"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                <Setter Property="Background" Value="#123A2B"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"><Image Width="12" Height="12" Margin="0,0,4,0"><Image.Style><Style TargetType="Image"><Setter Property="Source" Value="{local:SvgImage Source=interface/other/exclamation-mark-red.svg}"/><Style.Triggers><DataTrigger Binding="{Binding IsInstalled}" Value="True"><Setter Property="Source" Value="{local:SvgImage Source=interface/other/category-check-green.svg}"/></DataTrigger></Style.Triggers></Style></Image.Style></Image><TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding Definition.Description}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,10"/>
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#20364E" Height="1"/>
                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Tag="{Binding}" Click="Details_Click" Style="{StaticResource GhostButton}" Padding="10,6" Margin="0,0,6,0"><StackPanel Orientation="Horizontal"><Image Source="{local:SvgImage Source=interface/white/info-small.svg}" Width="15" Height="15" Margin="0,0,6,0"/><TextBlock Text="{Binding DetailsText}"/></StackPanel></Button>
                                <Button Tag="{Binding}" Click="Delete_Click" Padding="10,6" Margin="0,0,6,0" MinWidth="108" HorizontalAlignment="Left" HorizontalContentAlignment="Center" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
                                    <StackPanel Orientation="Horizontal"><Image Width="15" Height="15" Margin="0,0,6,0"><Image.Style><Style TargetType="Image"><Setter Property="Source" Value="{local:SvgImage Source=interface/white/category-trash.svg}"/><Style.Triggers><DataTrigger Binding="{Binding IsWindowsFeature}" Value="True"><Setter Property="Source" Value="{local:SvgImage Source=interface/white/toggle-left.svg}"/></DataTrigger></Style.Triggers></Style></Image.Style></Image><TextBlock Text="{Binding RemoveActionText}"/></StackPanel>
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            <Setter Property="MinWidth" Value="108"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWindowsFeature}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsWindowsFeature}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <ToggleButton Tag="{Binding}" Click="WindowsFeatureToggle_Click" IsChecked="{Binding IsInstalled, Mode=OneWay}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" Margin="0,0,6,0">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton" BasedOn="{StaticResource LibraryToggleButton}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWindowsFeature}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Button Tag="{Binding}" Click="Repair_Click" Cursor="Hand" Padding="10,6" Margin="0,0,6,0" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
                                    <StackPanel Orientation="Horizontal"><Image Source="{local:SvgImage Source=interface/white/download.svg}" Width="15" Height="15" Margin="0,0,6,0"/><TextBlock Text="Переустановить"/></StackPanel>
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsWindowsFeature}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Tag="{Binding}" Click="Download_Click" Cursor="Hand" Padding="10,6" Margin="0,0,6,0" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
                                    <StackPanel Orientation="Horizontal"><Image Width="15" Height="15" Margin="0,0,6,0"><Image.Style><Style TargetType="Image"><Setter Property="Source" Value="{local:SvgImage Source=interface/white/fluent-arrow-download.svg}"/><Style.Triggers><DataTrigger Binding="{Binding IsWindowsFeature}" Value="True"><Setter Property="Source" Value="{local:SvgImage Source=interface/white/toggle-right.svg}"/></DataTrigger></Style.Triggers></Style></Image.Style></Image><TextBlock Text="{Binding DownloadActionText}"/></StackPanel>
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWindowsFeature}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasDownloadAction}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Tag="{Binding}" Click="DownloadAndInstall_Click" Cursor="Hand" Padding="10,6" Margin="0,0,6,0" Content="Скачать и установить" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasDownloadAction}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsWindowsFeature}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Tag="{Binding}" Click="MoreActions_Click" Width="32" Height="30" Padding="0" Margin="6,0,0,0" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
                                    <Image Source="{local:SvgImage Source=interface/white/dots.svg}" Width="16" Height="16"/>
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                            <Setter Property="Width" Value="32"/>
                                            <Setter Property="Height" Value="30"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="6,0,0,0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWindowsFeature}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.ContextMenu>
                                        <ContextMenu Style="{StaticResource LibraryContextMenu}" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Style="{StaticResource LibraryMenuItem}" Header="Открыть папку установщика" Click="OpenInstallerFolder_Click" Tag="{Binding}"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="2" Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ProgressText}" Opacity="{Binding ProgressOpacity}" Foreground="{StaticResource MutedBrush}" FontSize="10" Visibility="{Binding ShowProgress, Converter={StaticResource BoolVisibility}}"/>
                                <ProgressBar Height="8" Margin="0,8,8,0" Opacity="{Binding ProgressOpacity}" Maximum="100" Value="{Binding Progress}" Visibility="{Binding ShowProgress, Converter={StaticResource BoolVisibility}}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding ShowProgress, Converter={StaticResource BoolVisibility}}">
                                <Button Tag="{Binding}" Click="PauseLibraryDownload_Click" Content="Ⅱ" Width="28" Height="26" Margin="0,6,4,0" Padding="0"
                                        IsEnabled="{Binding CanPauseDownload}" Style="{StaticResource GhostButton}" ToolTip="Пауза"/>
                                <Button Tag="{Binding}" Click="ResumeLibraryDownload_Click" Content="▶" Width="28" Height="26" Margin="0,6,4,0" Padding="0"
                                        IsEnabled="{Binding CanResumeDownload}" Style="{StaticResource GhostButton}" ToolTip="Возобновить"/>
                                <Button Tag="{Binding}" Click="CancelLibraryDownload_Click" Content="×" Width="28" Height="26" Margin="0,6,0,0" Padding="0"
                                        IsEnabled="{Binding IsBusy}" Style="{StaticResource GhostButton}" ToolTip="Отменить"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0">
            <StackPanel Margin="36,28,36,42">
                <Border x:Name="LibrariesBanner" Height="170" MinHeight="170" CornerRadius="16" BorderBrush="#174C8D" BorderThickness="1" Padding="20" Margin="0,0,0,18" HorizontalAlignment="Stretch">
                    <Border.Background>
                        <ImageBrush ImageSource="/interface/other/banner.jpg" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"/>
                    </Border.Background>
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="{local:SvgImage Source=interface/other/windows-svgrepo-com.svg}" Width="72" Height="72" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                            <TextBlock Text="Библиотеки для вашей системы" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Left"/>
                            <TextBlock Text="Подготовьте Windows к работе" Foreground="#B9CAE2" FontSize="16" TextWrapping="Wrap" TextAlignment="Left"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Margin="5,0,5,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" x:Name="CategoryComboBox" Style="{StaticResource LibraryFilterComboBoxStyle}" Margin="0,0,8,0" SelectionChanged="FilterChanged"/>
                    <ComboBox Grid.Column="1" x:Name="StatusComboBox" Style="{StaticResource LibraryFilterComboBoxStyle}" Margin="8,0,0,0" SelectionChanged="FilterChanged"/>
                </Grid>
                <ItemsControl x:Name="LibrariesItems" ItemTemplate="{StaticResource LibraryCardTemplate}">
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold" Margin="5,16,5,5"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                            <GroupStyle.Panel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </GroupStyle.Panel>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                </ItemsControl>
                <TextBlock x:Name="EmptyText" Text="Компоненты по заданным фильтрам не найдены." Foreground="{StaticResource MutedBrush}" Visibility="Collapsed" Margin="5,20"/>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Background="#102A45" BorderBrush="#3D8FE8" BorderThickness="1,1,0,0" Padding="18,12" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="QueueText" Text="Выбрано: 0" FontWeight="SemiBold"/>
                    <TextBlock x:Name="InstallStatusText" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Установить выбранное" Click="InstallSelected_Click" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"/>
                <Button Grid.Column="2" Content="Очистить очередь" Click="ClearQueue_Click" Style="{StaticResource GhostButton}" Margin="8,0,0,0"/>
                <Button Grid.Column="3" Content="Отмена" Click="CancelInstall_Click" Style="{StaticResource GhostButton}" Margin="8,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
