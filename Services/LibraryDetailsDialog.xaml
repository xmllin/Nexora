<Window x:Class="Nexora.Services.LibraryDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Nexora.Services"
        Width="620" MinWidth="520" MinHeight="360" SizeToContent="Height" MaxHeight="700"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="MinWidth" Value="34"/><Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="B" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="#3A121B"/>
                            <Setter TargetName="B" Property="BorderBrush" Value="#E04B60"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="B" Property="Background" Value="#561824"/>
                            <Setter TargetName="B" Property="BorderBrush" Value="#F06A78"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7FA7D1"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>
        <Style x:Key="ValueBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="#EAF3FF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </Window.Resources>
    <Border Background="#0B192A" BorderBrush="#2A4A69" BorderThickness="1" CornerRadius="14" Padding="0" ClipToBounds="True">
        <DockPanel LastChildFill="True">
            <Border x:Name="DragHeader"
                    DockPanel.Dock="Top"
                    Height="48"
                    Background="#102A45"
                    BorderBrush="#2A4A69"
                    BorderThickness="0,0,0,1"
                    Padding="10,0"
                    Cursor="Arrow"
                    ClipToBounds="True"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid HorizontalAlignment="Stretch">
                    <Button Click="Close_Click"
                            Style="{StaticResource DialogButton}"
                            Width="34"
                            Height="34"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                        <Image Source="{local:SvgImage Source=interface/white/fluent-dismiss.svg}" Width="15" Height="15"/>
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Margin="16,10,16,5"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          MaxHeight="620">
                <StackPanel>
                    <TextBlock x:Name="TitleText"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#F1F6FF"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>
                    <Grid x:Name="DetailsGrid" Margin="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>